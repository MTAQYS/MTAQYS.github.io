---
interface Props {
  text: string;
  id?: string;
}

const { text, id } = Astro.props;
const lines = text.split("\n");

function pieces(line: string) {
  return line.split(/(\*[^*]+\*)/g).filter(Boolean);
}
---

<h1 class="display" id={id}>
  {
    lines.map((line, index) => (
      <>
        {index > 0 && <br />}
        {pieces(line).map((piece) =>
          piece.startsWith("*") && piece.endsWith("*") ? <em>{piece.slice(1, -1)}</em> : piece,
        )}
      </>
    ))
  }
</h1>
