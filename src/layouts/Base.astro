---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Dictionary } from "../i18n/types";
import { pages, type PageId } from "../lib/routes";

interface Props {
  t: Dictionary;
  page: PageId;
  title: string;
  description: string;
}

const { t, page, title, description } = Astro.props;
const site = Astro.site;

if (!site) {
  throw new Error("Set site in astro.config, or SITE_URL at build time.");
}

const canonical = new URL(pages[page][t.lang], site).href;
const frHref = new URL(pages[page].fr, site).href;
const enHref = new URL(pages[page].en, site).href;
const ownCard = page === "home" || page === "services" || page === "tools" || page === "contact";
const ogImage = new URL(ownCard ? `/og/${t.lang}-${page}.png` : "/og-default-dark.png", site).href;
const otherLocale = t.lang === "fr" ? "en_US" : "fr_FR";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Dynamogic",
  url: new URL("/", site).href,
  email: "contact@dynamogic.com",
  logo: new URL("/app-icon-512.png", site).href,
};
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <script is:inline src="/theme.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={frHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={frHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dynamogic" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={otherLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.ogAlt} />
    <meta name="theme-color" content="#0E0F11" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header t={t} page={page} />
    <main id="contenu">
      <slot />
    </main>
    <Footer t={t} />
  </body>
</html>
